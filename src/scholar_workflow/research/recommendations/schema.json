{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/recommendation-submission-v1",
  "title": "Recommendation submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "run_id", "items"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "producer": {"$ref": "#/$defs/producer"},
    "run_id": {"$ref": "#/$defs/id"},
    "requirement": {"$ref": "#/$defs/requirement"},
    "items": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 500},
    "url": {"type": "string", "minLength": 1, "maxLength": 4096, "format": "uri"},
    "longText": {"type": "string", "minLength": 1, "maxLength": 60000},
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["requirement_id", "revision"],
      "properties": {"requirement_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}}
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_id", "name"],
      "properties": {
        "producer_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/shortText"},
        "host": {"$ref": "#/$defs/shortText"},
        "task_url": {"$ref": "#/$defs/url"}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "title", "url"],
      "dependentRequired": {"abstract_zh": ["abstract_original"], "description_zh": ["description_original"], "summary_zh": ["summary_sources"], "summary_sources": ["summary_zh"]},
      "properties": {
        "kind": {"enum": ["paper", "project", "blog"]},
        "item_type": {"enum": ["preprint", "journalArticle", "conferencePaper", "report", "manuscript", "blogPost", "webpage"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "url": {"$ref": "#/$defs/url"},
        "arxiv_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "doi": {"type": "string", "minLength": 1, "maxLength": 512},
        "authors": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/shortText"}},
        "published_at": {"type": "string", "anyOf": [{"format": "date"}, {"format": "date-time"}]},
        "abstract_original": {"$ref": "#/$defs/longText"},
        "abstract_zh": {"$ref": "#/$defs/longText"},
        "description_original": {"$ref": "#/$defs/longText"},
        "description_zh": {"$ref": "#/$defs/longText"},
        "summary_zh": {"$ref": "#/$defs/longText", "description": "Complete source-backed Chinese synopsis when no author abstract exists; follow the recommendation reading-content and shared style contracts. A tagline or snippet is not a synopsis."},
        "summary_sources": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/url"}},
        "project_url": {"$ref": "#/$defs/url"},
        "links": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/link"}}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["label", "url"],
      "properties": {"label": {"$ref": "#/$defs/shortText"}, "url": {"$ref": "#/$defs/url"}, "kind": {"$ref": "#/$defs/shortText"}}
    },
    "channel": {
      "type": "object", "additionalProperties": false, "required": ["name", "url"],
      "properties": {"name": {"$ref": "#/$defs/shortText"}, "url": {"$ref": "#/$defs/url"}}
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "metric", "value", "url", "observed_at"],
      "properties": {
        "platform": {"$ref": "#/$defs/shortText"}, "metric": {"$ref": "#/$defs/shortText"},
        "value": {"type": "number", "minimum": 0, "maximum": 1000000000000000},
        "url": {"$ref": "#/$defs/url"}, "observed_at": {"type": "string", "format": "date-time"},
        "period": {"$ref": "#/$defs/shortText"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["submission_id", "resource", "tags"],
      "properties": {
        "submission_id": {"$ref": "#/$defs/id"}, "resource": {"$ref": "#/$defs/resource"},
        "recommendation_reason": {"type": "string", "minLength": 1, "maxLength": 6000},
        "tags": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "channels": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/channel"}},
        "metrics": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/metric"}}
      }
    }
  }
}
