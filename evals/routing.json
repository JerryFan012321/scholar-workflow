{
  "description": "Skill routing eval — verifies correct skill is triggered for each input type",
  "cases": [
    {
      "id": "discover-paper",
      "input": "帮我找最近的 world model 论文",
      "expected_skill": "find-resource",
      "must_not_write": true
    },
    {
      "id": "additive-import",
      "input": "把这些论文加入 Zotero：2401.01234, 2312.56789",
      "expected_skill": "ingest-resource",
      "comment": "明确的新增性入库请求 → ingest-resource 直接执行:先经 zotero-mcp 存在性核验、确认目标 collection,随后新增性写入直接继续,无审批门(G4/G9)"
    },
    {
      "id": "file-technical-doc",
      "input": "归档这个 CUDA 官方 PDF 到知识库",
      "expected_skill": "ingest-resource",
      "expected_kind": "technical_document",
      "must_not_enter_zotero_paper_flow": true
    },
    {
      "id": "locate-paper",
      "input": "这篇论文在哪：2401.01234",
      "expected_skill": "find-resource",
      "expected_mode": "locate"
    },
    {
      "id": "build-lineage",
      "input": "画出 NeRF 到 3DGS 的发展脉络",
      "expected_skill": "build-literature-tree"
    },
    {
      "id": "survey-open-topic",
      "input": "帮我调研一下世界模型",
      "expected_skill": "survey-topic",
      "must_not_write": true,
      "comment": "宽泛开放式调研开口 → survey-topic 先界定范围再路由;不直接产出内容"
    },
    {
      "id": "survey-not-for-tree-verb",
      "input": "给我画一棵 3D 重建的文献树",
      "expected_skill": "build-literature-tree",
      "comment": "已点明要树 → 直达 build-literature-tree,不经 survey-topic 编排入口"
    },
    {
      "id": "check-consistency",
      "input": "检查一下我的库是否有漂移",
      "expected_skill": "check-consistency",
      "must_not_write": true
    },
    {
      "id": "export-annotations",
      "input": "把我在 DeepCAD 这篇论文里的批注整理成笔记",
      "expected_skill": "export-annotations",
      "must_not_write": true
    },
    {
      "id": "no-plugin-trigger",
      "input": "帮我写一个 Python 排序函数",
      "expected_skill": null,
      "comment": "普通代码任务不得触发本插件任何 skill"
    }
  ]
}
