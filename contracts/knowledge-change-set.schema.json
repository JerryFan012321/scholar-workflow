{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/knowledge-change-set.schema.json",
  "title": "Idempotent explicit Knowledge delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "source_receipt",
    "base_catalog_revision",
    "upsert_artifacts",
    "upsert_relations",
    "upsert_projections",
    "expected_base_hashes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "pattern": "^change:[0-9a-f]{64}$"},
    "source_receipt": {"type": "string", "minLength": 1, "maxLength": 256},
    "base_catalog_revision": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "upsert_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "upsert_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "upsert_projections": {
      "type": "array",
      "items": {"$ref": "#/$defs/projection"}
    },
    "expected_base_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "null"],
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "resource_id", "kind", "vault_path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["analysis_markdown", "analysis_canvas", "analysis_sidecar"]},
        "vault_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "relation", "to_id"],
      "properties": {
        "from_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "relation": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "to_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "kind", "target_id"],
      "properties": {
        "projection_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
