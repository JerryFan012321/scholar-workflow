{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-plan.schema.json",
  "title": "ActionPlan",
  "type": "object",
  "required": ["plan_id", "created_at", "expires_at", "input_digest", "actions"],
  "additionalProperties": false,
  "properties": {
    "plan_id":      { "type": "string", "format": "uuid" },
    "created_at":   { "type": "string", "format": "date-time" },
    "expires_at":   { "type": "string", "format": "date-time" },
    "input_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "config_version": { "type": "string" },
    "approved_at":  { "type": ["string", "null"], "format": "date-time" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_id", "operation"],
        "properties": {
          "resource_id":          { "type": "string" },
          "operation":            { "type": "string", "enum": ["create", "update", "skip", "conflict"] },
          "download_url":         { "type": ["string", "null"], "pattern": "^https://arxiv\\.org/" },
          "zotero_collection_key": { "type": ["string", "null"] },
          "obsidian_index":       { "type": ["string", "null"] },
          "vault_path":           { "type": ["string", "null"] },
          "notion_projection":    { "type": "boolean" },
          "conflicts":            { "type": "array", "items": { "type": "string" } },
          "skip_reason":          { "type": ["string", "null"] }
        }
      }
    }
  }
}
