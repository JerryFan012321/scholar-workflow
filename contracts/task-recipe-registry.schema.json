{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/task-recipe-registry.schema.json",
  "title": "Scholar Workflow TaskRecipe registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipes", "safety_policies"],
  "properties": {
    "schema_version": {"enum": [2, 3]},
    "model_profiles": {"type": "array", "items": {"$ref": "#/$defs/model_profile"}},
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/$defs/recipe"}
    },
    "safety_policies": {
      "type": "array",
      "items": {"$ref": "#/$defs/safety_policy"}
    }
  },
  "$defs": {
    "portable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "title",
        "project_required",
        "allowed_provider_ids",
        "allowed_project_ids",
        "allowed_tool_ids",
        "context_policy_id",
        "safety_policy_id",
        "allowed_efforts"
      ],
      "properties": {
        "recipe_id": {"$ref": "#/$defs/portable_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "project_required": {"type": "boolean"},
        "allowed_provider_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/portable_id"},
          "uniqueItems": true
        },
        "allowed_project_ids": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"$ref": "#/$defs/portable_id"},
              "uniqueItems": true
            }
          ]
        },
        "allowed_target_ids": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"$ref": "#/$defs/portable_id"},
              "uniqueItems": true
            }
          ]
        },
        "allowed_model_profile_ids": {
          "oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/portable_id"}, "uniqueItems": true}]
        },
        "allowed_tool_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/portable_id"},
          "uniqueItems": true
        },
        "context_policy_id": {"$ref": "#/$defs/portable_id"},
        "safety_policy_id": {"$ref": "#/$defs/portable_id"},
        "allowed_efforts": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["fast", "standard", "deep"]},
          "uniqueItems": true
        }
      }
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "title", "model", "supported_reasoning_efforts", "default_reasoning_effort", "is_default", "source"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/portable_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "supported_reasoning_efforts": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}},
        "default_reasoning_effort": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "is_default": {"type": "boolean"},
        "source": {"enum": ["codex-catalog", "local-config", "explicit"]}
      }
    },
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "model", "sandbox", "approval_policy"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/portable_id"},
        "policy_version": {"type": "integer", "minimum": 1},
        "model": {"$ref": "#/$defs/portable_id"},
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "approval_policy": {"const": "never"}
      }
    }
  }
}
