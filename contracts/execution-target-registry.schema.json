{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/execution-target-registry.schema.json",
  "title": "Scholar Workflow execution target registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "portable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind", "registered_root_id", "capabilities"],
      "properties": {
        "target_id": {"$ref": "#/$defs/portable_id"},
        "kind": {"enum": ["project", "vault", "folder"]},
        "registered_root_id": {"$ref": "#/$defs/portable_id"},
        "source_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/portable_id"}]},
        "field_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/portable_id"}]},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"},
          "uniqueItems": true
        }
      }
    }
  }
}
