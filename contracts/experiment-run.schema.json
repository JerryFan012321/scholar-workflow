{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/experiment-run.schema.json",
  "title": "Scholar Workflow experiment run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "record_state",
    "source",
    "entrypoint",
    "config",
    "dataset",
    "seed",
    "environment",
    "recipe_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9][a-z0-9-]{0,47}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "record_state": {"enum": ["draft", "frozen", "incomplete_legacy"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "entrypoint": {"$ref": "#/$defs/file_snapshot"},
    "config": {"$ref": "#/$defs/file_snapshot"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version", "split", "manifest"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "manifest": {"$ref": "#/$defs/file_snapshot"}
      }
    },
    "seed": {"type": "integer"},
    "environment": {"$ref": "#/$defs/file_snapshot"},
    "recipe_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
