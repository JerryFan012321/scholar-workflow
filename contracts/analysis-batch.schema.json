{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/analysis-batch.schema.json",
  "title": "AnalysisBatchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "zotero_item_key", "note_stem", "document"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "zotero_item_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
          "note_stem": {"type": "string", "minLength": 1, "maxLength": 240},
          "document": {"$ref": "analysis-ir.schema.json"}
        }
      }
    }
  }
}
