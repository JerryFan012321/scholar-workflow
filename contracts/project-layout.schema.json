{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/project-layout.schema.json",
  "title": "Scholar Workflow project layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "language",
    "package",
    "source_profile",
    "addons"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "language": {"const": "python"},
    "package": {
      "type": ["string", "null"],
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "source_profile": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/profile_selection"}
      ]
    },
    "addons": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile_selection"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "profile_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "integer", "const": 1}
      }
    }
  }
}
