{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholar-workflow.local/contracts/analysis-ir.schema.json",
  "title": "AnalysisDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "paper_title", "profile", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^analysis:[^\\s]+$"},
    "paper_title": {"type": "string", "minLength": 1, "maxLength": 1000},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "roles"],
      "properties": {
        "kind": {"enum": ["whole", "focused"]},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["task", "input", "workflow", "output", "boundary"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 38,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "role", "title", "body", "evidence"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "role": {"enum": ["task", "input", "workflow", "output", "boundary"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "body": {"type": "string", "minLength": 1, "maxLength": 20000},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "author_stated",
                  "analysis_inference",
                  "not_reported",
                  "unverifiable",
                  "not_applicable"
                ]
              },
              "anchor": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
              "detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
            }
          },
          "order": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
